# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI API Key (required for conversational AI and evaluation)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Neon Serverless PostgreSQL Connection String (required in production)
DATABASE_URL="postgresql://user:password@ep-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Secret (minimum 32 characters for HMAC signing)
SESSION_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# Allowed Origins (comma-separated list for CORS and Origin check; optional in dev)
# ALLOWED_ORIGINS="https://your-domain.com"
